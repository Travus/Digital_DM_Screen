# Dependencies — installed into a Docker volume, never onto the host.
node_modules/

# Build output.
# out/     electron-vite bundles (main, preload, renderer)
# release/ installers, plus release/smoke/*.png from the headless render check
out/
dist/
release/
*.tsbuildinfo

# npm/Electron/electron-builder caches, redirected here so CI can restore them
# with actions/cache. Locally these live in Docker volumes and this stays empty.
.cache/

# Logs and crash dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment and secrets. Nothing here uses them yet, but a stray .env
# should never become committable by accident.
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
# Local Claude Code settings — per-machine tool permissions, not project config.
.claude/
*.swp
*.swo
*~

# OS cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Deliberately tracked, and easy to lose to a broader rule later:
#   build/icon.svg, build/icon.png  packaging reads the PNG at build time
#   build/icons/*.png               the Linux icon set, made by scripts/gen-icons.sh
#   docs/*.png                      README screenshots
#   examples/*.dmscreen             the starter layout
