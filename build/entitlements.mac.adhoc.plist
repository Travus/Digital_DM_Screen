<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 runtime needs JIT compilation on Apple Silicon. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!--
    Electron's bundled frameworks retain their upstream signatures. An ad-hoc
    app has no matching Team ID, so hardened-runtime library validation must be
    disabled or the app exits before its first window. This file is used only by
    dist:mac:adhoc; a future Developer ID build uses electron-builder's defaults.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
